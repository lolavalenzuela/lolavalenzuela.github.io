# Foto original sin optimizar (17MB) — la versión que usa el sitio ya
# está en assets/img/about-foto.jpg, optimizada y liviana.
foto.png

# Archivos del sistema
.DS_Store

# Fuentes sin optimizar de las portadas: pesan 28MB y el sitio usa las
# versiones comprimidas de assets/img/. Se conservan en el disco local.
PORTADAS/
assets/img/originales/

# Material fuente de los proyectos: se conserva en el disco, pero al sitio
# solo suben las versiones ya optimizadas de assets/.
# La barra inicial ancla el patrón a la raíz del repo: sin ella, y como
# macOS no distingue mayúsculas, "PROYECTO*/" también tapaba
# assets/img/proyectos/ y se perdían todas las imágenes de los proyectos.
/PROYECTO*/
/assets/img/proyectos/originales/
/assets/video/originales/
